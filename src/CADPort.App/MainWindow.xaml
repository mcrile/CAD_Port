<Window x:Class="CADPort.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        Title="Tax-Aware 3D Portfolio Workspace" Height="840" Width="1320"
        Background="#15171C" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- 3D workspace -->
        <Grid Grid.Column="0">
            <h:HelixViewport3D x:Name="Viewport"
                               Background="#0E1014"
                               ShowCoordinateSystem="True"
                               ShowViewCube="True"
                               ViewCubeHorizontalPosition="Right"
                               ViewCubeVerticalPosition="Bottom"
                               IsHeadLightEnabled="False"
                               CameraRotationMode="Turntable">
                <!-- Mostly-ambient flat lighting: true colors from every angle, no
                     specular hotspots. Two dim opposing directionals add just enough
                     shading to read the box edges. -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#D2D2D2"/>
                            <DirectionalLight Color="#383838" Direction="-1,-1,-2"/>
                            <DirectionalLight Color="#2A2A2A" Direction="1,1,-1"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </h:HelixViewport3D>

            <!-- Legend overlay -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                    Background="#CC1E2127" CornerRadius="6" Padding="10" BorderBrush="#3A3F4A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="WORKSPACE" FontWeight="Bold" Foreground="#FFD14A" FontSize="11"/>
                    <TextBlock Text="X = Security   Y = Account   Z = Size" FontSize="11" Margin="0,3,0,6"/>
                    <TextBlock Text="● Red lot = embedded loss (harvest)" Foreground="#F2A8B8" FontSize="11"/>
                    <TextBlock Text="● Green lot = embedded gain (costly)" Foreground="#9BE0A8" FontSize="11"/>
                    <TextBlock Text="▬ Thin plane = model target" Foreground="#9BB6D8" FontSize="11"/>
                    <TextBlock Text="▬ Gold plane = post-trade (click + drag)" Foreground="#FFD14A" FontSize="11"/>
                    <TextBlock Text="■ Yellow overlay = proposed trade (over stack = sell, above = buy)" Foreground="#FFE38A" FontSize="11" Margin="0,3,0,0"/>
                    <TextBlock Text="Left-drag: orbit   Right-drag: pan   Wheel: zoom" Foreground="#9AA0A8" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- View selector (single portfolio vs all) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Background="#CC1E2127" CornerRadius="6" Padding="10" BorderBrush="#3A3F4A" BorderThickness="1">
                <StackPanel Width="170">
                    <TextBlock Text="VIEW" FontWeight="Bold" Foreground="#FFD14A" FontSize="11"/>
                    <ComboBox Margin="0,5,0,0"
                              ItemsSource="{Binding ViewOptions}"
                              SelectedItem="{Binding SelectedView, Mode=TwoWay}">
                        <!-- Dark text on the default light dropdown. A local Foreground on
                             the TextBlock beats the app-wide (light) TextBlock style, so
                             both the selection box and the dropdown items stay readable. -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#1A1D23"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Showing one portfolio" FontSize="10" Foreground="#9AA0A8" Margin="0,5,0,0"
                               Visibility="{Binding IsSinglePortfolioView, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Control panel -->
        <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="#2C313A" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TAX-AWARE 3D PORTFOLIO" FontSize="15" FontWeight="Bold" Foreground="#FFD14A"/>
                    <TextBlock Text="Visual portfolio construction &amp; rebalancing" Foreground="{StaticResource PanelMuted}" FontSize="11" Margin="0,1,0,4"/>

                    <!-- Z axis mode -->
                    <TextBlock Text="Z AXIS (POSITION SIZE)" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Market Value" Foreground="{StaticResource PanelForeground}" Margin="0,0,14,0"
                                     IsChecked="{Binding IsMarketValueMode, Mode=TwoWay}"/>
                        <RadioButton Content="Portfolio Weight" Foreground="{StaticResource PanelForeground}"
                                     IsChecked="{Binding IsWeightMode, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Auto modes -->
                    <TextBlock Text="AUTOMATIC REBALANCE" Style="{StaticResource SectionHeader}"/>
                    <Button Content="Mode A · Household Aggregate Rebalance" Command="{Binding HouseholdRebalanceCommand}"/>
                    <Button Content="Mode B · Account-Level Rebalance" Command="{Binding AccountRebalanceCommand}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Reset Planes" Command="{Binding ResetCommand}" Margin="0,2,3,2"/>
                        <Button Grid.Column="1" Content="Accept Trades" Command="{Binding AcceptTradesCommand}" Margin="3,2,0,2"
                                Background="#2E6F4E" BorderBrush="#3C8C63"/>
                    </Grid>

                    <!-- Accounts -->
                    <TextBlock Text="ACCOUNTS" Style="{StaticResource SectionHeader}"/>
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SectionBackground}" CornerRadius="4" Padding="8,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <CheckBox Content="Taxable" Margin="0,3,0,0" Foreground="{StaticResource PanelMuted}"
                                                      IsChecked="{Binding IsTaxable, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Cash adj. ($)" FontSize="10" Foreground="{StaticResource PanelMuted}"/>
                                            <TextBox Width="92" Text="{Binding CashAdjustment, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                                     Background="#1A1D23" Foreground="{StaticResource PanelForeground}"
                                                     BorderBrush="#454B57" HorizontalContentAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Selected position -->
                    <TextBlock Text="SELECTED POSITION" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource SectionBackground}" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedCurrentText}" Foreground="{StaticResource PanelMuted}" FontSize="11" Margin="0,2,0,0"/>
                            <StackPanel IsEnabled="{Binding HasSelection}" Margin="0,6,0,0">
                                <TextBlock Text="Post-trade shares" FontSize="11" Foreground="{StaticResource PanelMuted}"/>
                                <Slider x:Name="ShareSlider" Minimum="0" Maximum="{Binding SelectedSliderMax}"
                                        Value="{Binding SelectedPostShares, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="-10" Width="40" Click="OnNudgeMinus10"/>
                                    <Button Grid.Column="1" Content="-1" Width="36" Margin="3,2" Click="OnNudgeMinus1"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedPostShares, StringFormat={}{0:N0} sh}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Button Grid.Column="3" Content="+1" Width="36" Margin="3,2" Click="OnNudgePlus1"/>
                                    <Button Grid.Column="4" Content="+10" Width="40" Click="OnNudgePlus10"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedDeltaText}" Margin="0,6,0,0" FontWeight="Bold" Foreground="#FFD14A"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Metrics -->
                    <TextBlock Text="PORTFOLIO METRICS" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource SectionBackground}" CornerRadius="4" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Portfolio Value"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Metrics.CurrentPortfolioValue}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Cash"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Metrics.CurrentCash}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Proposed Cash"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Metrics.ProposedCash}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Realized Gains"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Metrics.RealizedGains}" HorizontalAlignment="Right" Foreground="#9BE0A8"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Realized Losses"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Metrics.RealizedLosses}" HorizontalAlignment="Right" Foreground="#F2A8B8"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Net Tax Impact"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Metrics.NetTaxImpact}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Harvested Losses"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Metrics.HarvestedLosses}" HorizontalAlignment="Right" Foreground="#9BE0A8"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Estimated Tax Cost" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Metrics.EstimatedTaxCost}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#FFD14A"/>
                        </Grid>
                    </Border>

                    <!-- Trades -->
                    <TextBlock Text="PROPOSED TRADES" Style="{StaticResource SectionHeader}"/>
                    <DataGrid ItemsSource="{Binding Trades}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="{StaticResource SectionBackground}"
                              RowBackground="#262A32" AlternatingRowBackground="#2C313A" Foreground="{StaticResource PanelForeground}"
                              BorderBrush="#2C313A" MaxHeight="220" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Acct" Binding="{Binding Account}" Width="*"/>
                            <DataGridTextColumn Header="Sec" Binding="{Binding Security}" Width="Auto"/>
                            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="Auto"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="Auto"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding MarketValue}" Width="Auto"/>
                            <DataGridTextColumn Header="Real G/L" Binding="{Binding RealizedGainLoss}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Tip: click a stack or gold plane to select, then drag the gold plane or use the slider."
                               Foreground="{StaticResource PanelMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,12"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
