<Application x:Class="CADPort.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark, CAD-like palette -->
        <SolidColorBrush x:Key="PanelBackground" Color="#1E2127"/>
        <SolidColorBrush x:Key="PanelForeground" Color="#E6E8EC"/>
        <SolidColorBrush x:Key="PanelMuted" Color="#9AA0A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD14A"/>
        <SolidColorBrush x:Key="SectionBackground" Color="#262A32"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#333845"/>
            <Setter Property="Foreground" Value="{StaticResource PanelForeground}"/>
            <Setter Property="BorderBrush" Value="#454B57"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
